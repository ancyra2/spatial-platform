{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022"],
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "baseUrl": ".",
    "paths": {
      "@spatial/contracts": ["libs/shared/contracts/src/index.ts"],
      "@spatial/util": ["libs/shared/util/src/index.ts"]
    },
    "ignoreDeprecations": "6.0"
  }
}
