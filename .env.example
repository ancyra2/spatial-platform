# Local development only. Replace placeholders in .env; never commit .env.
NODE_ENV=development
API_HOST=127.0.0.1
API_PORT=3000
CORS_ORIGINS=http://localhost:4200,http://127.0.0.1:4200
SWAGGER_ENABLED=true
# Proxy target is read by the web dev server from the process environment.
API_PROXY_URL=http://127.0.0.1:3000
POSTGRES_USER=spatial_dev
POSTGRES_PASSWORD=replace-with-local-password
POSTGRES_DB=spatial_dev
POSTGRES_PORT=5432
# URL-encode the password if it contains reserved URI characters.
DATABASE_URL=postgresql://spatial_dev:replace-with-local-password@127.0.0.1:5432/spatial_dev?schema=public
REDIS_PORT=6379
REDIS_PASSWORD=replace-with-local-redis-password
REDIS_URL=redis://:replace-with-local-redis-password@127.0.0.1:6379
